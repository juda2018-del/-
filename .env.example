# Jazal Admin Audio Studio — server-side secrets only
# Never commit real values. Add these in Vercel → Project Settings → Environment Variables.

# Required for production TTS (OpenAI Speech API → real MP3)
OPENAI_API_KEY=

# Optional fallback TTS provider
GOOGLE_TTS_API_KEY=

# Optional: openai | google (default: first configured)
TTS_PROVIDER=openai

# Optional OpenAI model override (default tts-1-hd)
OPENAI_TTS_MODEL=tts-1-hd

# Firebase project used to verify admin ID tokens (default jazal-audio)
FIREBASE_PROJECT_ID=jazal-audio
