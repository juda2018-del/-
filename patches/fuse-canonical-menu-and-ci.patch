-      - name: Commit responsive fixes
-        shell: bash
-        run: |
-          set -euo pipefail
-          git config user.name "github-actions[bot]"
-          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
-          git add app/page.tsx app/reels/page.tsx app/restaurants/RestaurantOrderClient.tsx MOBILE_RESPONSIVE_FIX_AR.txt .mobile-fix .github/workflows/apply-mobile-responsive-fix.yml || true
-          if git diff --cached --quiet; then
-            echo "No changes to commit"
-            exit 0
-          fi
-          git commit -m "Fix mobile responsive layouts"
-          git push origin main
