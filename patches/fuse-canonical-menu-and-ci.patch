-    runs-on: ubuntu-latest
-    steps:
-      - name: Checkout repository
-        uses: actions/checkout@v4
-        with:
-          fetch-depth: 0
-
-      - name: Decode fixed files
-        shell: bash
-        run: |
-          set -euo pipefail
-          base64 -d .mobile-fix/app_page.tsx.gz.b64 | gzip -d > app/page.tsx
